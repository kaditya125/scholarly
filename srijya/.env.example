# The origin the site is served from. Required for a production build: it is what
# canonical links, og:url, og:image, the Organization JSON-LD and sitemap.xml are
# built from. Without it those are omitted rather than guessed.
SITE_URL=https://example.com

# Where the contact form and the project brief are delivered. Both post the same
# JSON shape: { name, email, channel, subject, message } plus structured extras
# an endpoint may ignore.
#
# Leave it unset and both fall back to composing a pre-filled email in the
# visitor's own mail client. That works with no backend, but it is lossy — a
# visitor on mobile web with no mail app configured sees nothing happen at all.
# Set it before driving any traffic at /start.
#
# Example, against the existing inbox API:
#   VITE_CONTACT_ENDPOINT=https://<your-api-host>/api/contact/send-inquiry
VITE_CONTACT_ENDPOINT=

# Optional. A URL that accepts a JSON POST of { query } and returns { answer }.
# Leave unset and Ask Srijya answers only from the published help centre, which
# is the grounding either way — the endpoint gives fuller answers, not different
# facts. Keys stay server-side; nothing about the model belongs in this file.
VITE_ASSISTANT_ENDPOINT=
