# The origin this site is served from.
#
# Not a secret — it is the public address of the site, and it is committed
# deliberately so that `npm run build` produces correct canonical, og:url,
# og:image, Organization JSON-LD and sitemap.xml without anyone having to
# remember a shell variable. Change it here when the domain changes.
#
# NOTE: srijya.in is verified available but NOT YET REGISTERED. Register it and
# point DNS before deploying, or the canonical tag will name a domain that does
# not serve this site — which is worse than having no canonical at all.
SITE_URL=https://srijya.in

# Delivery for the contact form and the project brief. UNSET, so both currently
# fall back to the visitor's mail client — see .env.example for why that is
# lossy. Set this to the inbox API and rebuild before driving traffic at /start.
# The production API hostname is supplied at deploy time, not committed here.
# VITE_CONTACT_ENDPOINT=https://<your-api-host>/api/contact/send-inquiry
