# The origin the site is served from. Required for a production build: it is what
# canonical links, og:url, og:image, the Organization JSON-LD and sitemap.xml are
# built from. Without it those are omitted rather than guessed.
SITE_URL=https://example.com

# Optional. A URL that accepts a JSON POST from the contact form. Leave unset and
# the form composes a pre-filled email in the visitor's mail client instead.
VITE_CONTACT_ENDPOINT=
