# Dependencies
node_modules/

# Build output
dist/

# Environment / secrets — NEVER commit these
.env
.env.local
.env.*.local
secrets/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store

# Reports (generated)
reports/*.json

# Migration checkpoints (scripts/migrate-pinecone-to-qdrant.ts)
# Resume state and the failure log for a run in progress. Machine-local by nature: the
# checkpoint holds a live Pinecone pagination token, and the failure log lists vector ids from
# whichever run produced it. Committing either would let one machine's partial progress be
# mistaken for another's.
.migration/
